  <link name="spray_gun_base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://gz_spray_painting_plugin_demo/meshes/spray_gun/spray_gun.glb" scale="1 1 1" />
      </geometry>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005" />
    </inertial>
  </link>
  <joint name="spray_gun_base_to_tool0" type="fixed">
    <parent link="tool0" />
    <child link="spray_gun_base_link" />
    <origin rpy="0 0 -1.57" xyz="0 0 0" />
  </joint>
  <gazebo reference="finger_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="spray_gun_nozzle_link">
    <inertial>
      <mass value="0.01" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="nozzle_joint" type="fixed">
    <parent link="spray_gun_base_link" />
    <child link="spray_gun_nozzle_link" />
    <origin rpy="0.0 -1.57 0.0" xyz="0.0 -0.13 0.16" />
  </joint>
  <gazebo reference="nozzle_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo>
    <plugin filename="libSprayPaintPlugin.so" name="gz::sim::systems::SprayPaintPlugin">
      <nozzle_link>spray_gun_nozzle_link</nozzle_link>
      <cone_half_angle_deg>10</cone_half_angle_deg>
      <cone_max_range>0.8</cone_max_range>
      <spray_color>1.0 0.2 0.1 1.0</spray_color>
      <spray_topic>/spray_paint/trigger</spray_topic>
      <particle_rate>100</particle_rate>
      <num_rays>16</num_rays>
      <patch_spacing>0.02</patch_spacing>
      <paint_interval_steps>1</paint_interval_steps>
      <enable_particle_emitter>true</enable_particle_emitter>
      <perf_log_path>/ws/file_logs/spray_perf_n1.csv</perf_log_path>
      <patch_overlap_factor>1.30</patch_overlap_factor>
      <rim_reach>1.12</rim_reach>
    </plugin>
  </gazebo>
<link name="robot_pedestal_link"><inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="20" /><inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.1" /></inertial><visual><origin xyz="0 0 -0.4" rpy="0 0 0" /><geometry><cylinder radius="0.15" length="0.8" /></geometry><material name="pedestal_red"><color rgba="0.8 0.1 0.1 1" /></material></visual><collision><origin xyz="0 0 -0.4" rpy="0 0 0" /><geometry><cylinder radius="0.15" length="0.8" /></geometry></collision></link><joint name="pedestal_to_robot_base" type="fixed"><parent link="base_link" /><child link="robot_pedestal_link" /><origin xyz="0 0 -0.8" rpy="0 0 0" /></joint></robot>